    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
