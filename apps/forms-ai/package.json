{
  "name": "@integr8/forms-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Integr8 Forms for AI: an offline MCP server that AI coding tools use to build .integr8form files, with a terminal installer.",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "sea": "node scripts/build-sea.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@integr8/document-render": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "@integr8/form-package": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
