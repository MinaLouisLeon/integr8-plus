{
  "name": "@integr8/forms-ai",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Integr8 Forms for AI: an offline MCP server that AI coding tools use to build .integr8form files, with a terminal installer.",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/window/page/tsconfig.json",
    "test": "vitest run",
    "sea": "node scripts/build-sea.mjs"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@integr8/document-render": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "@integr8/form-package": "workspace:*",
    "@integr8/form-renderer-dom": "workspace:*",
    "@integr8/i18n": "workspace:*",
    "@integr8/tokens": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "jsdom": "30.0.1",
    "postject": "1.0.0-alpha.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
