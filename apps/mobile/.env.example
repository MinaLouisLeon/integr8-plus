# Integr8 Mobile — environment.
# Copy to apps/mobile/.env and fill in. Never commit it.
#
# Expo inlines anything prefixed `EXPO_PUBLIC_` into the bundle. There is no
# environment to read on somebody's phone, so none of these may be a secret —
# anyone can extract them from the app.
#
# Per-build values live in `eas.json` instead; this file is for local
# development.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development

# EXPO_PUBLIC_SENTRY_DSN=
