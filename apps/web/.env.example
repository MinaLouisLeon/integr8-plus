# Integr8 Web — environment.
# Copy to apps/web/.env.local and fill in. Never commit it.

APP_ENV=development

# ---------------------------------------------------------------------------
# The API
# ---------------------------------------------------------------------------

# Server-side only. Used by the route handlers that hold the refresh cookie, so
# it may point at an address only the server can reach.
API_BASE_URL=http://localhost:3000

# Sent to the browser. Must be reachable from a customer's machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Build identity
# ---------------------------------------------------------------------------

# Sent as `x-client-version` and used as the Sentry release. P20 sets it from
# the release process; without it a reported error cannot be tied to a build.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_ENV=development

# ---------------------------------------------------------------------------
# Error reporting
# ---------------------------------------------------------------------------

# Two DSNs because they are two runtimes. The public one reaches the browser and
# is therefore world-readable — which is expected for a Sentry DSN, and the
# reason it must not be an auth token.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps at build time. Without them a production
# stack trace names a line in a minified bundle.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
