# Integr8 API — environment.
# Copy to apps/api/.env and fill in. Never commit .env.
#
# The database and authentication variables are read by @integr8/db and
# @integr8/auth from this same environment. They are listed in
# packages/db/.env.example and packages/auth/.env.example rather than repeated
# here, because one value with two homes is one value that will disagree with
# itself.

# One of: development | test | staging | production
APP_ENV=development

PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Client support
# ---------------------------------------------------------------------------

# The oldest client build this deployment serves, returned on every response as
# `min-supported-client`.
#
# Raising it is how a breaking change is finally allowed — after every client
# below it has been given a clear, actionable way to update. A signed desktop
# binary and an App Store build cannot be force-updated, so this is not a
# formality.
API_MIN_SUPPORTED_CLIENT=0.1.0

# Where a client below the minimum is told to go. It appears in the error a
# person reads, so it must be a page that actually offers a download.
API_UPDATE_URL=https://integr8.example/download

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Per IP address, before authentication. Catches the noise that arrives with no
# credentials at all.
API_IP_RATE_LIMIT=300
API_IP_RATE_WINDOW_SECONDS=60

# Per company, after authentication. One noisy customer must not starve
# another.
API_TENANT_RATE_LIMIT=1200
API_TENANT_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------

# How long an idempotency key is remembered, and a replay still answered with
# the original response. A day covers a phone that was in a basement overnight.
API_IDEMPOTENCY_TTL_SECONDS=86400

# Largest request body accepted, in bytes. Media uploads go to R2 directly
# (P09), so this stays small.
API_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Optional in development. In production the process refuses to start without
# it: nothing would report an unhandled error.
# SENTRY_DSN=

# The build this is. Set by CI from the commit sha. Without it, "this started
# failing after some deploy" stays a guess.
API_RELEASE=development

SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
#
# The worker is a separate process (`pnpm --filter @integr8/api worker`), not a
# thread inside the API: a job that pins a core then degrades background work
# rather than every request, and the two scale independently.

WORKER_BATCH_SIZE=10
WORKER_IDLE_POLL_MS=2000

# How long a worker's claim on a job lasts. A lease, not a lock — a worker
# killed mid-job would otherwise leave its rows claimed forever.
WORKER_LEASE_MS=60000

# First retry delay; doubles each attempt, with full jitter.
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=3600000

# ---------------------------------------------------------------------------
# Supabase Auth, self-hosted — passwords and sign-in codes (P36)
# ---------------------------------------------------------------------------
#
# Required. There is no silent fallback to a fake identity provider: a service
# that quietly accepts any password when a variable is missing is a service
# that will do so in production on the day somebody mistypes a secret name.
#
# The Auth container's own base address, with no /auth/v1: the standalone
# container serves at its root. deploy/compose.yml sets http://auth:9999.
# SUPABASE_URL is no longer read, and the API refuses to start while it is set.
# SUPABASE_AUTH_URL=http://localhost:9999

# An HS256 token signed with the container's GOTRUE_JWT_SECRET; `pnpm --filter
# @integr8/auth keygen` prints both. Server-side only. It can do anything to
# the auth schema and must never reach a client.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Browser clients
# ---------------------------------------------------------------------------

# Origins allowed to call this API from a browser, comma-separated: the web
# app, and the desktop app's webview (tauri://localhost on macOS and Linux,
# http://tauri.localhost on Windows). Unset in development allows the local
# dev servers; unset in staging or production allows nothing, and production
# refuses to start.
API_CORS_ORIGINS=

# Where clients reach this API, for links it hands out (local media uploads).
# API_PUBLIC_URL=http://localhost:3000

# Where the web app lives, for links sent to people rather than to clients —
# today, the invitation an onboarded company's owner follows (P15). Unset means
# no link is produced at all rather than a guessed one: an invitation link that
# goes to the wrong host fails silently for the one person who cannot tell us.
# WEB_APP_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Encrypts employees' national ID, social insurance and bank account numbers
# (HR module, ADR-0010): 32 random bytes, base64 (`openssl rand -base64 32`).
# Unset: those numbers cannot be stored, shown or exported (503 hr_key_missing).
# Required in production. Keep it in the password manager, apart from the
# backups: a backup restored without it has those numbers unreadable for good.
# HR_DATA_KEY=
# Older HR keys while changing it, comma-separated, newest first: they open
# what they sealed and seal nothing. Move the old HR_DATA_KEY here, put a new
# one above, run `admin-cli hr-reseal`, and empty this once it reports nothing
# left (docs/database/runbook-backup-and-restore.md).
# HR_DATA_KEYS_PREVIOUS=

# Egyptian e-invoicing (docs/e-invoicing, ADR-0014). Seals each company's ETA
# client id and secret: 32 random bytes, base64 (`openssl rand -base64 32`).
# Unset or blank: the server starts, and no company can save or use ETA
# credentials (503 eta_key_missing). Every ETA_ setting may be left out or blank.
# ETA_CREDENTIALS_KEY=
# Production stays off until this is true; every company works on PreProd.
# ETA_ALLOW_PRODUCTION=false
# Extra CAs (PEM) trusted for PreProd only. TLS checks are never turned off.
# ETA_PREPROD_CA_FILE=
# Base URL overrides, for a local fake ETA.
# ETA_PREPROD_IDENTITY_URL=
# ETA_PREPROD_API_URL=
# ETA_REQUEST_TIMEOUT_MS=30000
# ETA_SIGNING_REQUEST_TTL_SECONDS=900
# ETA_MAX_STATUS_CHECKS=12

# r2: Cloudflare R2, one bucket per company. local: files on this machine's
# disk behind signed links, for development and tests; production refuses it.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.data/media
# Signs local upload and download links. Unset: a random secret per process.
# MEDIA_URL_SECRET=
# Largest single upload, in bytes.
MEDIA_MAX_BYTES=26214400
# Days a deleted file can be restored before its bytes are removed.
MEDIA_RESTORE_DAYS=30
# How often the worker sweeps abandoned uploads and purges deleted files.
MEDIA_MAINTENANCE_INTERVAL_SECONDS=900

# R2. One account-level token for the whole platform, held only by the API and
# worker: it creates and deletes company buckets (Admin Read & Write). Clients
# never see it — they get presigned links for one object at a time.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# Bucket names are <prefix>-<company id>. Unset: integr8-<APP_ENV>.
# R2_BUCKET_PREFIX=
# Only for a jurisdiction-restricted account.
# R2_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
# A Cloudflare API token with Account Analytics: Read only (no edit rights).
# The worker's nightly metering uses it to count each company's R2 operations
# and to check the storage ledger against the byte count Cloudflare bills from;
# `storage verify` uses it too. Without it every night's check is recorded as
# `unavailable`, and in production the API and worker warn at start-up.
# CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Push notifications (P14). `recording` keeps what would be sent, for tests and
# development; `expo` sends through Expo's push service to FCM and APNs.
# Production refuses to start without `expo`. See docs/mobile/job-execution.md.
PUSH_SENDER=recording
# Only when the EAS project has enhanced push security on. A secret.
# EXPO_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# PDF documents (docs/documents). The worker prints them with Chromium; the API
# image installs Debian's at /usr/bin/chromium. On a laptop without it, point
# PDF_CHROMIUM_PATH at any Chromium or Chrome, or use `recording` for a plain
# placeholder PDF. Production refuses `recording`.
PDF_RENDERER=chromium
# PDF_CHROMIUM_PATH=/usr/bin/chromium
# PDF_RENDER_TIMEOUT_MS=30000
# PDF_MAX_CONCURRENT=2

# ---------------------------------------------------------------------------
# Billing (P17)
# ---------------------------------------------------------------------------

# Who takes the money. `none` takes no card payments: Integr8 invoices every
# company directly and sets its plan from the dashboard, every company reads as
# invoiced, the checkout and portal answer `billing_invoiced`, and dunning does
# nothing; no provider keys are needed, and production accepts it. `recording`
# keeps what would have been sent and hands back links to billing.invalid, for
# tests and development; `stripe` is real. Production refuses to start on
# `recording`, and on `stripe` with a test-mode key (sk_test_, rk_test_) — a
# deployment that meant to charge cards and quietly did not is worse than one
# that will not boot.
#
# Nothing here is Stripe-shaped above the adapter: the entitlement service and
# the columns talk about "a provider's customer" and "a provider's price", so a
# market Stripe does not serve needs an adapter rather than a migration: Paymob,
# for Egyptian cards, is the one planned (docs/billing/README.md).
BILLING_PROVIDER=recording

# Stripe. Both are secrets and both belong in .env, never in the repository.
# The webhook secret is the one that matters most: it is what stops anybody who
# knows the URL from telling this API that a bill has been paid.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Where the provider's hosted checkout and portal send the browser back to.
# Unset: WEB_APP_URL. With neither, the billing routes answer 503 rather than
# inventing an address.
# BILLING_RETURN_URL=http://localhost:3100

# Days a new company gets before it has to pay.
BILLING_TRIAL_DAYS=14
# Days between a payment failing and the company going read-only. Read-only,
# never deletion: a company that pays late is still a customer. Reminders go
# out in-app during this window — and only in-app, because there is no email
# sender in this system yet. See apps/api/src/billing/dunning.ts.
BILLING_GRACE_DAYS=14

# ---------------------------------------------------------------------------
# Email (P18)
# ---------------------------------------------------------------------------

# Who carries the mail. `recording` keeps what would have been sent, for
# development and tests; `resend` sends it. Production refuses `recording`,
# because everything that depends on this fails *silently* without it: an
# invitation nobody receives looks, from the inside, exactly like one that was
# sent. Until this phase there was no sender at all, so every invitation this
# product created was undeliverable.
EMAIL_SENDER=recording

# Resend. A secret: it can send mail as this domain.
# RESEND_API_KEY=re_...
# `Name <address@domain>`. The domain has to be verified at the provider, or
# every message is refused or filed as spam.
# EMAIL_FROM=Integr8 Plus <hello@yourdomain.example>

# WEB_APP_URL above is not optional once email is on: it is where every link in
# every message points. Production refuses to start without it.

# ---------------------------------------------------------------------------
# Self-serve onboarding (P18)
# ---------------------------------------------------------------------------

# Signing up needs nothing of its own: it uses EMAIL_SENDER to send the
# verification link, WEB_APP_URL to build it, and BILLING_TRIAL_DAYS for the
# trial the new company starts on. With EMAIL_SENDER=recording the whole flow
# works and the message is kept in memory instead of sent, which is how the
# integration suite reads the token back out.

# Public sign-up is off unless this says open. Off means companies are set up
# by Integr8 from the platform dashboard, and /v1/signup answers 403
# signup_closed. The web app has its own copy, NEXT_PUBLIC_SIGNUP, baked into
# the bundle at build time; keep the two the same.
PUBLIC_SIGNUP=off

# The token the release pipeline presents to GET /v1/build/companies to learn
# which companies' own desktop installers and phone apps to build. Make it
# long and random (openssl rand -hex 32) and store the same value as the
# BUILD_TOKEN repository secret on GitHub. Unset means the route answers 404.
# BUILD_TOKEN=

# Who starts a company's app build when the dashboard asks for one: switching
# "Build apps" on, or "Rebuild apps". off (the default) leaves it to a person
# running "Build company apps" from GitHub Actions; the dashboard says so.
# github starts that workflow through GitHub's API, and then needs both lines
# below or the API refuses to start. The token is a fine-grained personal
# access token for this one repository with "Actions: read and write" and
# nothing else: it can start any workflow there, so treat it as a secret.
# APP_BUILDS=off
# GITHUB_BUILD_TOKEN=
# GITHUB_BUILD_REPOSITORY=your-github-owner/integr8-plus
# The branch whose copy of the workflow runs (and whose version it builds).
# GITHUB_BUILD_REF=main

# ---------------------------------------------------------------------------
# The AI assistant (docs/ai; ADR-0001)
# ---------------------------------------------------------------------------

# The kill switch. Off means no company gets the assistant whatever its plan
# or override says. Turn it on only once a provider below is configured and
# the plan policies in the dashboard are what you intend.
AI_ENABLED=false

# Who answers. `recording` is a deterministic fake that needs no account;
# `groq`, `gemini`, `anthropic` and `openai` are live and need their key.
# `none` is no AI provider at all: every company is answered from the help
# library, with no key, no model and no cost (ADR-0002 D12). Only the provider
# named here is ever called: there is no fallback to another one. Switching is
# this one line plus the key and model ids.
#
# A missing key or Help model never stops the server (ADR-0002): companies get
# help-library answers instead, a missing Insights or Agent model lowers that
# level, and the platform AI screen says which. Keys are server secrets: never
# put one in a NEXT_PUBLIC_* or EXPO_PUBLIC_* variable, a log or the repository.
AI_PROVIDER=recording
# AI_GROQ_API_KEY=
# AI_GEMINI_API_KEY=
# AI_ANTHROPIC_API_KEY=
# AI_OPENAI_API_KEY=

# OpenAI only. The endpoint (HTTPS only in production), and the reasoning
# effort sent with every call when set. GPT-6 Luna is a reasoning model and
# tool calling through Chat Completions may need `none`; a model that does not
# reason refuses the parameter, so leave it unset for one.
# AI_OPENAI_BASE_URL=https://api.openai.com/v1
# AI_OPENAI_REASONING_EFFORT=none

# Anthropic only. Claude's 5.x models think by default, and their thinking
# counts against the output bound: `low` keeps answers inside it. Leave it
# unset for Claude Haiku 4.5, which refuses the parameter.
# AI_ANTHROPIC_EFFORT=low

# After OpenAI says the account's prepaid credit is spent, how long this
# process stops asking it. Questions are answered from the help library
# meanwhile; nothing else in the product is affected.
# AI_CREDIT_EXHAUSTED_PAUSE_SECONDS=300

# The model ids, one per level, exactly as the provider lists them today. No
# defaults on purpose: model names change without a deployment. Check the
# provider's current model list before enabling. Each level runs its own
# model; one level never borrows another's. For OpenAI, e.g. gpt-6-luna on
# all three.
# AI_MODEL_HELP=
# AI_MODEL_INSIGHTS=
# AI_MODEL_AGENT=

# Which data classes each provider may see beyond public help, once the
# platform has also approved the company. Empty means company data never
# leaves the building, whatever level a company is on.
# AI_PROVIDER_APPROVED_DATA_CLASSES=groq:company_operational

# Prices per million tokens, in USD micros (1 USD = 1,000,000), as JSON.
# A model not listed is costed at the defaults and marked estimated.
# `cachedInputPerMillion` is optional: without it, input served from the
# provider's prompt cache is charged at the full input rate. Check the
# provider's pricing page before relying on these; the GPT-6 Luna figures
# below are $0.10 input, $0.01 cached input, $0.50 output per million.
# AI_MODEL_PRICES=[{"provider":"openai","model":"gpt-6-luna","inputPerMillion":100000,"cachedInputPerMillion":10000,"outputPerMillion":500000}]
# AI_DEFAULT_PRICE_INPUT_PER_MILLION_MICROUSD=3000000
# AI_DEFAULT_PRICE_OUTPUT_PER_MILLION_MICROUSD=15000000

# The whole deployment's monthly provider budget, in USD micros. Reserved
# before any company's share is; a request past it answers 503
# ai_budget_unavailable with no figure shown to the company.
AI_GLOBAL_MONTHLY_BUDGET_MICROUSD=5000000

# Ceilings no plan or override may exceed, whatever an admin types.
# AI_MAX_INPUT_TOKENS=8000
# AI_MAX_OUTPUT_TOKENS=1500
# AI_MAX_PROVIDER_CALLS=6
# AI_MAX_TOOL_STEPS=6
# AI_MAX_CONCURRENT_PER_TENANT=4
# AI_MAX_CONCURRENT_PER_USER=2
# AI_REQUEST_TIMEOUT_MS=20000
# AI_RESERVATION_TTL_SECONDS=120
# AI_ACTION_TTL_SECONDS=300
# AI_HISTORY_TURNS=6
