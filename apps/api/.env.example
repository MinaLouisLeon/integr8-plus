# Integr8 API — environment.
# Copy to apps/api/.env and fill in. Never commit .env.
#
# The database and authentication variables are read by @integr8/db and
# @integr8/auth from this same environment. They are listed in
# packages/db/.env.example and packages/auth/.env.example rather than repeated
# here, because one value with two homes is one value that will disagree with
# itself.

# One of: development | test | staging | production
APP_ENV=development

PORT=3000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Client support
# ---------------------------------------------------------------------------

# The oldest client build this deployment serves, returned on every response as
# `min-supported-client`.
#
# Raising it is how a breaking change is finally allowed — after every client
# below it has been given a clear, actionable way to update. A signed desktop
# binary and an App Store build cannot be force-updated, so this is not a
# formality.
API_MIN_SUPPORTED_CLIENT=0.1.0

# Where a client below the minimum is told to go. It appears in the error a
# person reads, so it must be a page that actually offers a download.
API_UPDATE_URL=https://integr8.example/download

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Per IP address, before authentication. Catches the noise that arrives with no
# credentials at all.
API_IP_RATE_LIMIT=300
API_IP_RATE_WINDOW_SECONDS=60

# Per company, after authentication. One noisy customer must not starve
# another.
API_TENANT_RATE_LIMIT=1200
API_TENANT_RATE_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Requests
# ---------------------------------------------------------------------------

# How long an idempotency key is remembered, and a replay still answered with
# the original response. A day covers a phone that was in a basement overnight.
API_IDEMPOTENCY_TTL_SECONDS=86400

# Largest request body accepted, in bytes. Media uploads go to R2 directly
# (P09), so this stays small.
API_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# Optional in development. In production the process refuses to start without
# it: nothing would report an unhandled error.
# SENTRY_DSN=

# The build this is. Set by CI from the commit sha. Without it, "this started
# failing after some deploy" stays a guess.
API_RELEASE=development

SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
#
# The worker is a separate process (`pnpm --filter @integr8/api worker`), not a
# thread inside the API: a job that pins a core then degrades background work
# rather than every request, and the two scale independently.

WORKER_BATCH_SIZE=10
WORKER_IDLE_POLL_MS=2000

# How long a worker's claim on a job lasts. A lease, not a lock — a worker
# killed mid-job would otherwise leave its rows claimed forever.
WORKER_LEASE_MS=60000

# First retry delay; doubles each attempt, with full jitter.
WORKER_RETRY_BASE_MS=5000
WORKER_RETRY_MAX_MS=3600000

# ---------------------------------------------------------------------------
# Supabase Auth — credentials and magic links
# ---------------------------------------------------------------------------
#
# Required. There is no silent fallback to a fake identity provider: a service
# that quietly accepts any password when a variable is missing is a service
# that will do so in production on the day somebody mistypes a secret name.

# SUPABASE_URL=https://PROJECT_REF.supabase.co

# Server-side only. It can do anything to the auth schema and must never reach
# a client.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Browser clients
# ---------------------------------------------------------------------------

# Origins allowed to call this API from a browser, comma-separated: the web
# app, and the desktop app's webview (tauri://localhost on macOS and Linux,
# http://tauri.localhost on Windows). Unset in development allows the local
# dev servers; unset in staging or production allows nothing, and production
# refuses to start.
API_CORS_ORIGINS=

# Where clients reach this API, for links it hands out (local media uploads).
# API_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# local: files on this machine's disk behind signed links, for development and
# tests. Production refuses it; P09 adds r2.
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=.data/media
# Signs local upload and download links. Unset: a random secret per process.
# MEDIA_URL_SECRET=
# Largest single upload, in bytes.
MEDIA_MAX_BYTES=26214400
