{
  "name": "@integr8/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "worker": "tsx --env-file-if-exists=.env src/jobs/worker-main.ts",
    "platform-admin": "tsx --env-file-if-exists=.env src/platform/admin-cli.ts",
    "openapi": "tsx --env-file-if-exists=.env src/openapi/emit.ts",
    "error-codes": "tsx src/testing/error-codes-cli.ts",
    "demo-company": "tsx --env-file-if-exists=.env src/demo/cli.ts",
    "storage": "tsx --env-file-if-exists=.env src/media/storage-cli.ts",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@integr8/auth": "workspace:*",
    "@integr8/core": "workspace:*",
    "@integr8/db": "workspace:*",
    "@integr8/document-render": "workspace:*",
    "@integr8/eta": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "@integr8/form-input": "workspace:*",
    "@integr8/i18n": "workspace:*",
    "@sentry/node": "10.74.0",
    "fastify": "5.12.3",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.63.0",
    "sharp": "0.35.4",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/api-client": "workspace:*",
    "@integr8/eslint-config": "workspace:*",
    "@integr8/offline": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
