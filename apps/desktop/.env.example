# Integr8 Desktop — environment.
# Copy to apps/desktop/.env and fill in. Never commit it.
#
# Vite inlines anything prefixed `VITE_` at build time, so these are constants
# in the shipped binary rather than values read on a customer's laptop. None of
# them may be a secret.

VITE_API_BASE_URL=http://localhost:3000
VITE_APP_ENV=development

# Sent as `x-client-version` and used as the Sentry release. P20 sets it from
# the release process.
VITE_APP_VERSION=0.1.0

# VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Tauri — release builds only
# ---------------------------------------------------------------------------
#
# The updater's private signing key. Whoever holds it can sign an update that
# every installed copy will accept and run, so it lives in a secret manager and
# never in this file. `src-tauri/updater.key` is git-ignored; CI reads the key
# from these variables.
#
# TAURI_SIGNING_PRIVATE_KEY=
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
