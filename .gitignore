# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
out/
.next/
*.tsbuildinfo

# tooling caches
.turbo/
coverage/
.eslintcache
.vitest/

# environment — never commit real values
.env
.env.*
!.env.example

# The key generator's output, if it is ever written inside the repository: the
# setup guide writes it to the temporary folder instead, but a stray copy holds
# every signing key and sign-in secret in plain text.
keys.txt
*-keys.txt
*.keys

# native build artefacts (Tauri / Expo)
src-tauri/target/
.expo/

# The Tauri updater's private signing key. Whoever holds it can sign an update
# that every installed copy will accept and run. It belongs in a secret manager,
# and CI reads it from TAURI_SIGNING_PRIVATE_KEY.
**/src-tauri/updater.key
**/src-tauri/*.key

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local media storage (MEDIA_STORAGE=local)
.data/

# Claude Code agent worktrees, created beside the checkout while a session runs.
.claude/worktrees/
