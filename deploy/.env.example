# Integr8 Plus — one environment file for the compose stack.
# Copy to deploy/.env and fill in. Never commit deploy/.env.
#
# Two modes, chosen by APP_ENV:
#
#   staging     a production-shaped stack for testing. The fakes are allowed:
#               local media storage, recording billing and email, the fake
#               geocoder. Nothing leaves the machine. This is what to run first.
#   production  the API refuses to start unless every external service below is
#               real and configured (see assertProductionReady in
#               apps/api/src/config.ts). Switch to it once the keys exist.
#
# Every variable the API and worker read is documented in apps/api/.env.example,
# packages/db/.env.example and packages/auth/.env.example. This file is the
# subset a deployment needs.
#
# Each container gets only the lines it needs: deploy/compose.yml names them
# service by service. The API and the worker never see POSTGRES_PASSWORD,
# DATABASE_URL_ADMIN, the role passwords or SUPABASE_AUTH_JWT_SECRET.

APP_ENV=staging

# The images. Unset, `up -d --build` builds both on this machine. To pull
# GitHub's instead, set both to the same release tag and change it at each
# update; a rollback sets the previous release's tag. `:main` and `:staging`
# carry unreleased code and are for a test box only, never production.
# API_IMAGE=ghcr.io/your-github-owner/integr8-api:vX.Y.Z
# WEB_IMAGE=ghcr.io/your-github-owner/integr8-web:vX.Y.Z

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------

# Where browsers reach the API and the web app. With a reverse proxy in front
# (Caddy, nginx, a cloud load balancer), these are its public hostnames.
PUBLIC_API_URL=https://api.your-domain.example
WEB_APP_URL=https://app.your-domain.example
API_PUBLIC_URL=https://api.your-domain.example

# Browser origins allowed to call the API. The web app, plus the desktop app's
# webview origins.
API_CORS_ORIGINS=https://app.your-domain.example,tauri://localhost,http://tauri.localhost

# Public sign-up. off (the default) means only you create companies, from the
# platform dashboard; the marketing pages send visitors to the contact page
# instead of a sign-up form. The API reads this at run time and the web image
# bakes it in at build time, so change it, then rebuild the web image.
PUBLIC_SIGNUP=off
# Where the contact page tells visitors to write. Baked into the web image.
CONTACT_EMAIL=hello@your-domain.example
# Starting a company's app build from the dashboard (switching "Build apps"
# on, or "Rebuild apps"). off: the dashboard says to run "Build company apps"
# from GitHub Actions by hand. github: it starts that workflow itself, with a
# fine-grained token for this repository only, "Actions: read and write".
# The API refuses to start with github and either line below missing.
# APP_BUILDS=github
# GITHUB_BUILD_TOKEN=
# GITHUB_BUILD_REPOSITORY=your-github-owner/integr8-plus
# Shared with GitHub (repository secret BUILD_TOKEN): the release pipeline
# presents it to learn which companies' own apps to build. openssl rand -hex 32.
# Optional: blank means no company apps are built and the list answers 404.
BUILD_TOKEN=
# Where installed desktop apps look for updates: the web app reads the newest
# release of this repository (owner/name) and offers it at /desktop-updates.
# Blank means no app is ever offered an update. GITHUB_RELEASES_TOKEN only if
# the repository becomes private: fine-grained, Contents: read on it alone.
GITHUB_RELEASES_REPOSITORY=your-github-owner/integr8-plus
# GITHUB_RELEASES_TOKEN=

# Host ports the stack listens on, on 127.0.0.1 only (deploy/compose.yml):
# nothing outside the machine reaches them directly. Put a reverse proxy with
# TLS in front (Caddy), or the Cloudflare Tunnel connector on the test box.
API_PORT=3000
WEB_PORT=3001

# ---------------------------------------------------------------------------
# Database: the compose Postgres, on this machine. Nothing else is needed.
# ---------------------------------------------------------------------------

POSTGRES_PASSWORD=change-me-owner-password
INTEGR8_APP_PASSWORD=change-me-app-password
INTEGR8_AUTH_PASSWORD=change-me-auth-password
# The platform role the API and the worker use outside one company (staff work,
# new companies, the job queue). Not a superuser; see docs/database/README.md.
INTEGR8_PLATFORM_PASSWORD=change-me-platform-password

# The owner's connection. Only the bootstrap and migrate services get it.
DATABASE_URL_ADMIN=postgres://postgres:change-me-owner-password@postgres:5432/integr8
DATABASE_URL=postgres://integr8_app:change-me-app-password@postgres:5432/integr8
DATABASE_URL_AUTH=postgres://integr8_auth:change-me-auth-password@postgres:5432/integr8
DATABASE_URL_PLATFORM=postgres://integr8_platform:change-me-platform-password@postgres:5432/integr8

# Backups (docs/database/runbook-backup-and-restore.md). Read by
# deploy/vps/backup-postgres.sh and restore-drill.sh from root's cron, not by
# any container. Without BACKUP_REMOTE the nightly dumps stay on this machine
# and are lost with it; each run says so.
# An rclone remote path the nightly dump is copied to, e.g. r2crypt: (an R2
# bucket behind rclone's crypt layer, set up as the runbook's Part 2 says). A
# copy that fails makes the run fail.
# BACKUP_REMOTE=r2crypt:
# How many copies to keep there; older ones are deleted. Default 30.
# BACKUP_REMOTE_KEEP=30
# A heartbeat monitor's URL (Better Stack, healthchecks.io), called after each
# good night and with /fail added after a bad one.
# BACKUP_PING_URL=

# ---------------------------------------------------------------------------
# Tokens and secrets — generate with: pnpm --filter @integr8/auth keygen
# ---------------------------------------------------------------------------

AUTH_ISSUER=https://api.your-domain.example
# The four lines keygen prints, pasted as they are.
# The signing key's id, carried in every token so a rotation can be staged.
AUTH_SIGNING_KEY_ID=
# The private key, as a JSON Web Key. A secret.
AUTH_SIGNING_KEY=
# The public keys tokens are verified against, as a JSON array.
AUTH_VERIFICATION_KEYS=
# Encrypts super admins' second-factor secrets at rest. Rotating it makes every
# enrolled second factor unreadable.
PLATFORM_SECRET_KEY=
# Encrypts employees' national ID, social insurance and bank account numbers
# (HR module). 32 random bytes, base64: `openssl rand -base64 32`. Optional,
# and a blank line is the same as unset: without it those numbers cannot be
# stored, shown or exported (503 hr_key_missing). Keep it with the database
# backups: losing it loses them.
HR_DATA_KEY=
# Seals each company's Egyptian Tax Authority (ETA) e-invoicing client id and
# secret (e-invoicing module, ADR-0014). 32 random bytes, base64:
# `openssl rand -base64 32`. Optional: blank is the same as unset, and the
# server starts; no company can then save or use ETA credentials (503
# eta_key_missing). E-invoicing is off for every company until Integr8 switches
# it on, so this can wait until then. Keep it with the database backups.
ETA_CREDENTIALS_KEY=
# Lets companies switch to the ETA production environment. Leave false until
# a company has passed PreProd testing; see docs/e-invoicing/RUNBOOK.md.
ETA_ALLOW_PRODUCTION=false
# Optional PEM file of extra CAs trusted for ETA PreProd only.
# ETA_PREPROD_CA_FILE=

# ---------------------------------------------------------------------------
# Sign-in: the self-hosted Supabase Auth container (P36). Required in every
# mode: there is no fake sign-in. The three lines keygen prints last, pasted
# as they are. See docs/auth/self-hosted-auth.md.
# ---------------------------------------------------------------------------

# Signs the service role key. Read by the auth container. A secret.
SUPABASE_AUTH_JWT_SECRET=
# What the API presents to Auth's admin endpoints: an HS256 token signed with
# the secret above. Server-side only; it can do anything to the auth schema.
SUPABASE_SERVICE_ROLE_KEY=
# The password of supabase_auth_admin, the database role Auth runs as. The
# bootstrap service creates the role with it; it goes inside a connection
# string, so keygen's base64url value is safe as it is.
SUPABASE_AUTH_DB_PASSWORD=
# Where the API reaches Auth. compose.yml already sets http://auth:9999; set
# this only to point elsewhere. The old SUPABASE_URL must not be set: the API
# refuses to start with it.
# SUPABASE_AUTH_URL=http://auth:9999

# ---------------------------------------------------------------------------
# Release identity and error reporting
# ---------------------------------------------------------------------------

APP_VERSION=1.2.2
API_RELEASE=1.2.2
SENTRY_DSN=
WEB_SENTRY_DSN=
WEB_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# External services. Fakes in staging; all required in production.
# ---------------------------------------------------------------------------

# r2 | local
MEDIA_STORAGE=local
# One account-level token with Admin Read & Write: it creates company buckets.
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_PREFIX=integr8-staging

# mapbox | fake
GEOCODER=fake
# MAPBOX_ACCESS_TOKEN=

# expo | recording
PUSH_SENDER=recording
# EXPO_ACCESS_TOKEN=

# stripe | recording
BILLING_PROVIDER=recording
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Days a new company gets before it has to pay, and days between a failed
# payment and read-only.
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=14

# resend | recording
EMAIL_SENDER=recording
# RESEND_API_KEY=re_...
# EMAIL_FROM=Integr8 Plus <hello@your-domain.example>

# PDF documents (docs/documents/RUNBOOK.md). The image brings Chromium and the
# fonts, so there is nothing to set up; the QR codes point at WEB_APP_URL.
# `recording` makes placeholder PDFs and production refuses it.
PDF_RENDERER=chromium

# ---------------------------------------------------------------------------
# The AI assistant (docs/ai/RUNBOOK.md). Off until you turn it on. A missing
# key or model never stops the API: companies get answers from the help
# library instead, and the platform AI screen says why.
# Not using AI at all? AI_ENABLED=true with AI_PROVIDER=none answers every
# company from the help library, with no key, no model and no cost.
# ---------------------------------------------------------------------------

AI_ENABLED=false
# none | recording | groq | gemini | anthropic | openai. Only this one is ever called.
AI_PROVIDER=recording
# The selected provider's key, from your secret manager. Never in a public
# build variable, a log or the repository.
# AI_OPENAI_API_KEY=
# AI_OPENAI_REASONING_EFFORT=none
# Anthropic only: low | medium | high | xhigh | max, for Claude's 5.x models.
# AI_ANTHROPIC_EFFORT=low
# One model per level; a level without one is not served.
# AI_MODEL_HELP=gpt-6-luna
# AI_MODEL_INSIGHTS=gpt-6-luna
# AI_MODEL_AGENT=gpt-6-luna
# Prices in USD micros per million tokens; check the provider's pricing page.
# AI_MODEL_PRICES=[{"provider":"openai","model":"gpt-6-luna","inputPerMillion":100000,"cachedInputPerMillion":10000,"outputPerMillion":500000}]
# Integr8's own monthly ceiling for the whole deployment, in USD micros
# (5000000 is five dollars). Not the provider's prepaid balance.
AI_GLOBAL_MONTHLY_BUDGET_MICROUSD=5000000

# ---------------------------------------------------------------------------
# Limits. The defaults in apps/api/.env.example are right for a first deployment.
# ---------------------------------------------------------------------------

API_MIN_SUPPORTED_CLIENT=0.1.0
API_UPDATE_URL=https://app.your-domain.example/download
