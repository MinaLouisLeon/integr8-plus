# Copy to deploy/local/.env (git-ignored) and fill in. Development only.

# The Postgres owner's password; the same one as in DATABASE_URL_ADMIN in
# packages/db/.env and apps/api/.env.
POSTGRES_PASSWORD=

# The same value as SUPABASE_AUTH_DB_PASSWORD in packages/db/.env.
SUPABASE_AUTH_DB_PASSWORD=

# Signs the Auth container's tokens; apps/api/.env's SUPABASE_SERVICE_ROLE_KEY
# must be a service_role token signed with it.
SUPABASE_AUTH_JWT_SECRET=
