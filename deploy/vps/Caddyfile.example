# Two public names, one machine. Caddy obtains a certificate for each from
# Let's Encrypt on first request and renews it; nothing else to configure.
#
#   sudo cp deploy/vps/Caddyfile.example /etc/caddy/Caddyfile
#   sudo sed -i 's/YOUR-DOMAIN.com/example.com/' /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# The ports are the host ports from deploy/.env (WEB_PORT and API_PORT).
#
# Caddy replaces any X-Forwarded-For a visitor sends with the visitor's real
# address. The API's per-address sign-in limit relies on that, for requests that
# come straight in and for the web app's sign-in, which passes the header on. If
# a CDN is ever put in front (Cloudflare's orange cloud), add its address ranges
# with `trusted_proxies`, or every visitor will share the CDN's addresses.

# Strict-Transport-Security tells a browser that has seen this site once to use
# HTTPS only, for a year. Deliberately without includeSubDomains or preload:
# other names under the domain (the test box, mail, MyRooms) are not this
# file's to promise, and preload cannot be undone quickly. The web app sends its
# own content-security policy and frame headers (apps/web/next.config.ts); the
# API, which serves JSON and files, gets its browser headers here.

app.YOUR-DOMAIN.com {
    header Strict-Transport-Security "max-age=31536000"

    reverse_proxy localhost:3001
}

api.YOUR-DOMAIN.com {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    # The health checks are for this machine, not the internet: they name the
    # release and what is failing. Docker's health check and the heartbeat
    # (deploy/vps/heartbeat.sh) call them on 127.0.0.1:3000.
    @health path /health /health/*
    respond @health 404

    reverse_proxy localhost:3000
}
