    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "26.4.2",
    "react-i18next": "17.0.13"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
