{
  "name": "@integr8/eta",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@integr8/core": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "asn1js": "3.1.0",
    "pkijs": "3.4.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
