{
  "name": "@integr8/tokens",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./fonts.css": "./fonts.css"
  },
  "files": [
    "dist",
    "theme.css",
    "fonts.css"
  ],
  "scripts": {
    "build": "tsc --build && tsx src/emit-css.ts",
    "clean": "rm -rf dist .turbo theme.css *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "css": "tsx src/emit-css.ts"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/alexandria": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0"
  }
}
