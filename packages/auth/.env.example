# @integr8/auth — authentication configuration.
# Copy to packages/auth/.env and fill in. Never commit .env.
#
# Generate the three key variables with:
#   pnpm --filter @integr8/auth keygen

APP_ENV=development

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# The `iss` claim. Verified on every token, so a token minted by staging cannot
# open production. Use the API's real base URL per environment.
AUTH_ISSUER=https://api.integr8.local

# The `aud` claim. One audience for all four clients: they differ by role, not
# by token.
AUTH_AUDIENCE=integr8-clients

# ---------------------------------------------------------------------------
# Keys — EdDSA over Ed25519
# ---------------------------------------------------------------------------

# The private signing key, as a JWK. Belongs in a secret manager, never in git;
# gitleaks runs on this repository and will say so.
AUTH_SIGNING_KEY=

# Which key signed a token. Must match the `kid` inside AUTH_SIGNING_KEY.
AUTH_SIGNING_KEY_ID=

# Public keys that may verify a token, as a JSON array of JWKs. Served at the
# JWKS endpoint and embedded in the mobile app so an offline grant can be
# verified with no network.
#
# To rotate: add the new public key here and deploy everywhere; then switch
# AUTH_SIGNING_KEY and AUTH_SIGNING_KEY_ID; then remove the old public key only
# once every token it signed has expired — which, with a seven-day offline
# grant, is seven days.
AUTH_VERIFICATION_KEYS=

# ---------------------------------------------------------------------------
# Lifetimes. Each is a security decision with a cost on the other side.
# ---------------------------------------------------------------------------

# Travels on every request and cannot be revoked mid-flight, so revoking a
# session takes effect within this long. Fifteen minutes.
AUTH_ACCESS_TOKEN_TTL_SECONDS=900

# How long a device stays signed in without being used. Thirty days.
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# The ceiling rotation cannot extend past. Ninety days.
AUTH_SESSION_MAX_TTL_SECONDS=7776000

# How long the mobile app opens with no network at all. Seven days.
# The tradeoff is written up in docs/auth/offline-access.md. Lower it for a
# customer with a stricter policy; do not raise it without writing down why.
AUTH_OFFLINE_GRANT_TTL_SECONDS=604800

# How long an invitation stays acceptable. Long enough to survive a holiday.
AUTH_INVITATION_TTL_SECONDS=604800

# How long a super admin may act as somebody else. One hour: longer than
# reproducing a reported problem takes, short enough not to become a habit.
AUTH_IMPERSONATION_TTL_SECONDS=3600

# ---------------------------------------------------------------------------
# Rate limiting and lockout
# ---------------------------------------------------------------------------

AUTH_LOCKOUT_THRESHOLD=10
AUTH_LOCKOUT_DURATION_SECONDS=900

# Failures older than this stop counting, so occasional typos never accumulate
# into a lockout.
AUTH_LOCKOUT_WINDOW_SECONDS=3600

# The limit that catches one common password tried across many addresses —
# the attack per-address lockout never sees.
AUTH_IP_ATTEMPT_LIMIT=50
AUTH_IP_ATTEMPT_WINDOW_SECONDS=900

# Length beats composition rules. See password-policy.ts.
AUTH_MIN_PASSWORD_LENGTH=12

# ---------------------------------------------------------------------------
# The platform dashboard (P15) — super admins, not customers
# ---------------------------------------------------------------------------

# Encrypts super admins' TOTP secrets at rest, AES-256-GCM. 32 bytes, base64;
# `pnpm --filter @integr8/auth keygen` prints one. No default: a deployment that
# forgets it must fail to start rather than fall back to a key everybody knows.
#
# Rotating it makes every enrolled second factor unreadable, so every super
# admin has to enrol again. Plan it.
PLATFORM_SECRET_KEY=

# Shorter than a tenant access token: this one can reach every company, and the
# dashboard is a browser tab on a desk rather than a phone on a roof.
PLATFORM_ACCESS_TOKEN_TTL_SECONDS=300

# How long the dashboard can be left alone before it has to sign in again.
PLATFORM_REFRESH_TOKEN_TTL_SECONDS=3600

# The ceiling on one platform session, however often it is refreshed. Eight
# hours — a working day, then sign in again.
PLATFORM_SESSION_TTL_SECONDS=28800

# Lower than a tenant account's ten: there are two or three of these accounts
# and none of them should be guessing.
PLATFORM_LOCKOUT_THRESHOLD=5
PLATFORM_LOCKOUT_DURATION_SECONDS=900

# ---------------------------------------------------------------------------
# Supabase Auth — credentials and magic links only
# ---------------------------------------------------------------------------

# SUPABASE_URL=https://PROJECT_REF.supabase.co

# The service role key. Server-side only: it can do anything to the auth schema
# and must never reach a client.
# SUPABASE_SERVICE_ROLE_KEY=
