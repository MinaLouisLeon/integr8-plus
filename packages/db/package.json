{
  "name": "@integr8/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db": "tsx --env-file-if-exists=.env src/migrator/cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/seed/cli.ts",
    "db:templates": "tsx --env-file-if-exists=.env src/seed/templates-cli.ts"
  },
  "dependencies": {
    "@integr8/core": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "kysely": "0.28.9",
    "pg": "8.16.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "22.20.2",
    "@types/pg": "8.15.6",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
