# @integr8/db — database configuration.
# Copy to packages/db/.env and fill in. Never commit .env.
#
# The database is a plain Postgres: the compose container on a server
# (deploy/compose.yml), or one on your machine. `pnpm --filter @integr8/db db
# bootstrap` creates the roles below; docs/database/README.md explains them.

# One of: development | test | staging | production
APP_ENV=development

# ---------------------------------------------------------------------------
# Connections. Two roles, two very different privilege levels.
# ---------------------------------------------------------------------------

# The runtime role. Every tenant request uses this, RLS applies to it, and the
# process refuses to start if it turns out to be the schema owner.
DATABASE_URL=postgres://integr8_app:PASSWORD@localhost:5432/integr8

# The schema owner. Migrations, seeds and company provisioning. RLS does NOT
# apply to it, so it never belongs in an environment that serves tenant
# traffic — leave it unset on API containers.
#
# A direct connection: migrations hold advisory locks and run multi-statement
# transactions, neither of which survives a transaction-mode pooler.
DATABASE_URL_ADMIN=postgres://postgres:PASSWORD@localhost:5432/integr8

# The pre-authentication role. Sign-in has to decide whether an address is
# locked out, and which companies an identity belongs to, before any company is
# known — neither question can be scoped by tenant. This role reaches those two
# tables and one view and nothing else, so the tenant runtime role never needs a
# cross-tenant privilege. Leave unset on containers that never handle sign-in.
DATABASE_URL_AUTH=postgres://integr8_auth:PASSWORD@localhost:5432/integr8

# ---------------------------------------------------------------------------
# Pool sizing. Every value has a default; override when a container needs it.
# ---------------------------------------------------------------------------

# Physical connections this container opens.
DB_POOL_MAX=10

# Deliberately small: sign-in is a fraction of traffic and every connection in
# this pool can read across companies.
DB_AUTH_POOL_MAX=4

DB_POOL_IDLE_MS=30000
DB_POOL_ACQUIRE_TIMEOUT_MS=10000

# A tenant request that has not finished in this long is a bug, and it is
# holding a pooled connection while it is one.
DB_STATEMENT_TIMEOUT_MS=15000

# How many tenant data sources stay warm, and how long an unused one survives.
# Today an entry is a handle onto the shared pool; after P35 an entry may own a
# real pool, and this becomes the number of live pools.
DB_TENANT_CACHE_MAX=200
DB_TENANT_CACHE_IDLE_MS=300000

# ---------------------------------------------------------------------------
# Bootstrap and tests. Not needed in normal development.
# ---------------------------------------------------------------------------

# Read by `db bootstrap` when creating the two login roles.
# Generate each with: openssl rand -base64 32
# INTEGR8_APP_PASSWORD=
# INTEGR8_AUTH_PASSWORD=

# Optional (P36): also create supabase_auth_admin and the `auth` schema for the
# self-hosted Supabase Auth container, with this password. Left unset, bootstrap
# skips it. `pnpm --filter @integr8/auth keygen` prints one.
# SUPABASE_AUTH_DB_PASSWORD=

# The integration suite truncates tables. It refuses to run unless APP_ENV=test
# AND this is set to exactly this value. Never set it against a database that
# holds anything you want.
# INTEGR8_TEST_DATABASE=i-know-this-database-is-disposable
