{
  "name": "@integr8/form-package",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/test-support/fixtures.d.ts",
      "default": "./dist/test-support/fixtures.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@integr8/core": "workspace:*",
    "@integr8/document-render": "workspace:*",
    "@integr8/form-engine": "workspace:*",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@integr8/eslint-config": "workspace:*",
    "@integr8/typescript-config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
